{
    "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "**",
            "!**/dist/**",
            "!**/node_modules/**",
            "!**/coverage/**",
            "!apps/examples/src/jolt/**",
            "!apps/examples/public/**",
            "!.yarn/**",
            "!yarn.lock"
        ]
    },
    "linter": {
        "enabled": true,
        "rules": {
            "complexity": {
                "noForEach": "off"
            },
            "suspicious": {
                "noExplicitAny": "off"
            },
            "style": {
                "noNonNullAssertion": "off"
            }
        }
    },
    "formatter": {
        "indentWidth": 4,
        "lineWidth": 100
    },
    "javascript": {
        "formatter": {
            "trailingCommas": "none",
            "bracketSameLine": false
        }
    }
}
