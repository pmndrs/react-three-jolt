{
    "name": "react-three-jolt-root",
    "private": true,
    "version": "0.0.0",
    "repository": "https://github.com/isaac-mason/react-three-jolt.git",
    "author": "Dennis Smolek",
    "contributors": [
        "Dennis Smolek",
        "Isaac Mason <isaac@isaacmason.com>"
    ],
    "license": "MIT",
    "packageManager": "yarn@4.18.0",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "test": "yarn workspaces foreach -A -t run test",
        "build": "yarn workspaces foreach -A -t run build",
        "change": "yarn changeset",
        "publish": "yarn build && yarn test && changeset publish",
        "version": "yarn changeset version && yarn install --mode update-lockfile",
        "lint": "biome check .",
        "format": "biome format --write .",
        "docs": "curl -sL https://raw.githubusercontent.com/pmndrs/docs/refs/heads/main/preview.sh | MDX=docs ICON=⚡ LOGO=logo.png NEXT_PUBLIC_LIBNAME='React Three Jolt' NEXT_PUBLIC_LIBNAME_SHORT='r3/jolt' GITHUB=https://github.com/pmndrs/react-three-jolt sh",
        "docs:build": "npx -y @pmndrs/docs@4 build docs docs/out --format website"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "@changesets/cli": "^3.0.3"
    },
    "engines": {
        "node": ">=22"
    },
    "resolutions": {
        "@radix-ui/react-icons": "^1.3.2",
        "three-stdlib": "^2.36.1"
    }
}
