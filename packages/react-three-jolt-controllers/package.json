{
    "name": "@react-three/jolt-controllers",
    "description": "Controllers for @react-three/jolt",
    "keywords": [
        "physics",
        "jolt-physics",
        "react-three-fiber",
        "react",
        "three"
    ],
    "version": "0.0.1",
    "author": "Dennis Smolek",
    "contributors": [
        "Dennis Smolek",
        "Isaac Mason <isaac@isaacmason.com>"
    ],
    "license": "MIT",
    "homepage": "https://github.com/pmndrs/react-three-jolt",
    "bugs": {
        "url": "https://github.com/pmndrs/react-three-jolt/issues"
    },
    "type": "commonjs",
    "engines": {
        "node": ">=22"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            },
            "default": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "files": [
        "dist/index.*",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "scripts": {
        "test": "tsc -p tsconfig.test.json --noEmit && vitest run --coverage",
        "build": "tsc --noEmit && tsc -p tsconfig.build.json --emitDeclarationOnly --declarationMap && rollup --config rollup.config.mjs",
        "format": "biome format --write .",
        "lint": "biome check ."
    },
    "peerDependencies": {
        "@react-three/fiber": ">=10.0.0-0",
        "jolt-physics": ">=1.1.0",
        "react": ">=19.0 <19.3",
        "react-dom": ">=19.0 <19.3",
        "three": ">=0.185"
    },
    "peerDependenciesMeta": {
        "jolt-physics": {
            "optional": false
        }
    },
    "dependencies": {
        "@react-three/jolt": "0.0.1",
        "@react-three/jolt-addons": "0.0.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "@react-three/fiber": "10.0.0-alpha.5",
        "@react-three/test-renderer": "10.0.0-alpha.5",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@types/react": "~19.2.18",
        "@types/react-dom": "~19.2.7",
        "@types/three": "^0.186.0",
        "@typescript/typescript6": "^6.0.2",
        "@vitest/coverage-v8": "^5.0.1",
        "esbuild": "^0.28.2",
        "happy-dom": "^20.14.5",
        "jolt-physics": "^1.1.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "rollup": "^4.63.4",
        "rollup-plugin-copy": "^3.5.0",
        "rollup-plugin-dts": "^6.5.1",
        "rollup-plugin-esbuild": "^6.2.1",
        "rollup-plugin-filesize": "^10.0.0",
        "three": "^0.186.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.0",
        "vitest": "^5.0.1"
    }
}
