// Typechecks the test tree as well as src (issue #145).
//
// `tsconfig.json` only covers `src`, so nothing ever checked `test/**` - test files could drift
// (a stale `any`, a removed API still called, a suppression for an error that no longer exists)
// without anything failing. `yarn test` runs this before vitest, so a type error in a test is a
// failing test run rather than something only vitest's own transpile-and-hope would shrug off.
//
// Nothing is added to `types` here: the packages point `typeRoots` at their own `./types`
// folder, and the tests import everything they use from `vitest` explicitly, so no ambient
// globals are needed.
{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        // widened to the workspace root: this emits nothing, and some tests share helpers across
        // packages (`test/jolt-alloc.ts` lives in the core package)
        "rootDir": "../..",
        // test helpers legitimately take arguments they ignore (spies, stub listeners)
        "noUnusedParameters": false
    },
    "include": ["src", "test"]
}
